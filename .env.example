# Copy to `.env` for docker-compose:
#   cp .env.example .env
#
# Required: inbound auth for clients (your own gateway key, NOT upstream keys).
WORKER_AUTH_KEY=REPLACE_ME

# Optional: public port on your server (docker-compose will expose ${PUBLIC_PORT}:8788).
# PUBLIC_PORT=30018

# Optional: IP allowlist (comma-separated). If set, requests must come from these IPs/CIDRs.
# - Supports exact IP and IPv4 CIDR (e.g. 1.2.3.4,10.0.0.0/8)
# WORKER_ALLOWED_IPS=1.2.3.4,10.0.0.0/8
# If you run behind a reverse proxy (Nginx/Caddy) and want to trust X-Forwarded-For / X-Real-IP:
# WORKER_TRUST_PROXY_HEADERS=true

# Optional: built-in web UI at GET / (and /ui), protected by Basic Auth.
# WEB_UI_ENABLED=true
# WEB_UI_BASIC_USER=admin
# WEB_UI_BASIC_PASS=REPLACE_ME_LONG_RANDOM
# Optional: allow the web UI to write `/config/rsp4copilot.config.jsonc` via /admin/api/config (dangerous; keep UI private).
# WEB_UI_CONFIG_WRITE=false
# Optional: allow the web UI to view secrets via /admin/api/secrets (dangerous; keep UI private).
# WEB_UI_SECRETS_VIEW=false
# Optional: allow showing secrets in plain text (requires WEB_UI_SECRETS_VIEW=true).
# WEB_UI_SECRETS_REVEAL=false
# Optional: allow writing upstream keys via /admin/api/upstream_keys (requires WEB_UI_SECRETS_VIEW=true).
# WEB_UI_SECRETS_WRITE=false
# Optional: allow adding new apiKeyEnv that are not yet in config (requires WEB_UI_SECRETS_VIEW=true).
# WEB_UI_SECRETS_ADD_NEW=false
#
# Upstream keys (example for configs/rsp4copilot.config.example.jsonc aggregation mode):
OPENAI_API_KEY_RELAY_A=REPLACE_ME
OPENAI_API_KEY_RELAY_B=REPLACE_ME
GEMINI_API_KEY=REPLACE_ME
CLAUDE_API_KEY=REPLACE_ME
